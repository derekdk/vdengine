# Smoke test: Level Builder phase 5 tile-edit flow
# Enter Development mode, switch to Select Tile Mode, exercise tile actions, then return to play.
wait startup
wait_frames 2

press R
wait_frames 2

press ENTER
wait_frames 3

press E
wait_frames 3

press C
wait_frames 3

press D
wait_frames 3
press X
wait_frames 3
press Z
wait_frames 3
press V
wait_frames 3
press A
wait_frames 3
press W
wait_frames 3
press V
wait_frames 3

press A
wait_frames 3

press Q
wait_frames 3

press ENTER
wait_frames 3

keydown D
wait 1100
press SPACE
wait 900
keyup D
wait 250

press R
wait 250

exit