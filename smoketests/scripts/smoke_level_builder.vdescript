wait_frames 2

press R
wait_frames 2

press ENTER
wait_frames 3

press N
wait_frames 3

press RIGHTBRACKET
wait_frames 3

press P
wait_frames 3

press E
wait_frames 3

press X
wait_frames 3

press D
wait_frames 3

press V
wait_frames 3

press Q
wait_frames 3

press J
wait_frames 3

press E
wait_frames 3

press X
wait_frames 3

press V
wait_frames 3

press U
wait_frames 3

press U
wait_frames 3

press I
wait_frames 3

press I
wait_frames 3

press F5
wait_frames 3

press F9
wait_frames 3

press Q
wait_frames 3

press ENTER
wait_frames 3

keydown D
wait 1100
press SPACE
wait 900
keyup D
wait 250

press R
wait 250

exit