# Smoke test: RunGame
# Jump, reach game over, then restart with jump.
wait startup
press SPACE
wait_frames 2
assert scene "main" state.jumping == 1
wait 5000
assert scene "main" state.game_over == 1
press SPACE
wait_frames 2
assert scene "main" state.game_over == 0
assert scene "main" state.score == 0
exit
