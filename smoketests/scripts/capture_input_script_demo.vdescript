# capture_input_script_demo.vdescript
# Golden image capture for input script demo.
# Runs the full input sequence, then screenshots the final state.
# No compare step — run verify_input_script_demo.vdescript to verify.

wait startup

# Activate all 8 panels in sequence
press A
wait 100

keydown W
wait 200
keyup W
wait 100

hold RIGHT 400
wait 100

press shift+B
wait 100

press ctrl+D
wait 100

click 520 468
wait 100

scroll 760 468 -3
wait 100

mousedown 1000 468
wait 150
mouseup 1000 468
wait 100

# Position cursor at top centre (world 0.0, 3.5)
mousemove 640 108
wait 100

# Light up all 3 pips via loop
label spin_start
press SPACE
wait 150
loop spin_start 3

wait 200

# Wait for rendering to settle then capture
wait_frames 5
screenshot render_verify_output/input_script_demo.png
wait 100

exit
